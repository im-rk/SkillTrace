# Copy to .env and fill in real values before `docker compose -f docker-compose.prod.yml up`.
# Never commit the filled-in .env -- it holds real secrets and DB credentials.

# --- Database (managed Postgres in real deployment; see docker-compose.prod.yml for local) ---
POSTGRES_USER=skilltrace
POSTGRES_PASSWORD=change-me
POSTGRES_DB=skilltrace
DATABASE_URL=postgresql+asyncpg://skilltrace:change-me@postgres:5432/skilltrace
SYNC_DATABASE_URL=postgresql+psycopg://skilltrace:change-me@postgres:5432/skilltrace

# --- Redis / Celery (managed Redis in real deployment) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BCRYPT_ROUNDS=12
# true in any real deployment (HTTPS only) -- only false for local http:// testing.
COOKIE_SECURE=true

# --- CORS ---
# Must be the frontend's exact deployed origin: scheme + host, no path, no trailing
# slash, http vs https matters. A mismatch here silently breaks every cross-origin
# request (the browser's console shows a CORS error; the server logs nothing useful).
FRONTEND_ORIGIN=https://your-frontend.example.com

# --- Frontend build (baked in at `docker build` time -- see frontend.Dockerfile) ---
# The backend's own public URL, as the BROWSER will reach it (https:// + wss:// in prod).
NEXT_PUBLIC_API_URL=https://your-backend.example.com

# --- Live session gateway / evaluation pipeline tuning (safe to leave at defaults) ---
EXAM_START_LOCK_TTL_MS=5000
HEARTBEAT_INTERVAL_SECONDS=10
STALE_SESSION_THRESHOLD_SECONDS=30
AUTO_SUBMIT_SWEEP_SECONDS=10
SUBMISSION_PEL_MIN_IDLE_MS=30000
EXAM_AUTO_CLOSE_SWEEP_SECONDS=60

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=600
REDEEM_RATE_LIMIT_PER_USER_PER_MINUTE=5
REDEEM_RATE_LIMIT_PER_IP_PER_MINUTE=60

# --- Deployment verification ---
# Turn on temporarily against a NEWLY deployed host to verify its reverse proxy passes
# WebSocket upgrades through (see infra/nginx/nginx.conf, scripts/ws_echo_check.py, and
# docs/adr/0013-websocket-deployment-verification.md), then turn back off.
ENABLE_WS_ECHO_SPIKE=false
